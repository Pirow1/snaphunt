{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "Cross-Origin-Opener-Policy", "value": "same-origin" },
        { "key": "Cross-Origin-Embedder-Policy", "value": "credentialless" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/((?!api|assets|icons|sw\\.js|workbox-.*|registerSW\\.js|manifest\\.webmanifest|.*\\.(?:wasm|onnx|js|css|png|jpg|jpeg|svg|webp|ico|woff2?)).*)", "destination": "/index.html" }
  ]
}
