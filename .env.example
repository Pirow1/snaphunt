# Public (frontend) — read by Vite at build time
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Rush B game mode URL (set after deploying rush-b branch to Vercel)
VITE_RUSH_B_URL=https://your-rush-b-deployment.vercel.app

# Server-only — set on the Supabase edge function via `supabase secrets set`
# Never put this in .env.local; never commit it.
# ANTHROPIC_API_KEY=sk-ant-...
